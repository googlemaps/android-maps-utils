<resources>
    <!--
    Distance or elevation in feet. %1$s is the pre-formatted numeric value (e.g., "528" or "14,440").
    -->
    <string name="amu_in_feet">%1$s ft</string>

    <!--
    Distance in miles. %1$s is the pre-formatted numeric value (e.g., "0.3", "2.0", or "12").
    -->
    <string name="amu_in_miles">%1$s mi</string>

    <!--
    Distance or elevation in meters. %1$s is the pre-formatted numeric value (e.g., "450" or "4,401").
    -->
    <string name="amu_in_meters">%1$s m</string>

    <!--
    Distance in kilometers. %1$s is the pre-formatted numeric value (e.g., "1.0", "2.5", or "10").
    -->
    <string name="amu_in_kilometers">%1$s km</string>
</resources>
