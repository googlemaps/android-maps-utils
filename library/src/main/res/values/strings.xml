<resources>
    <!--
    Distance or elevation in feet, formatted to 0 decimal places.
    For example, 1234.56 feet will be formatted as "1,235 ft".
    -->
    <string name="amu_in_feet" translatable="false">%1$,.0f ft</string>

    <!--
    Distance in miles under 10 miles, formatted to 1 decimal place (at least 2 significant digits
    for 1.0–9.9 mi, keeping trailing .0).
    For example, 2.0 miles will be formatted as "2.0 mi" and 1.24 miles as "1.2 mi".
    -->
    <string name="amu_in_miles" translatable="false">%1$,.1f mi</string>

    <!--
    Distance in miles for 10 miles or greater, formatted to 0 decimal places.
    For example, 12.4 miles will be formatted as "12 mi".
    -->
    <string name="amu_in_miles_whole" translatable="false">%1$,.0f mi</string>

    <!--
    Distance or elevation in meters, formatted to 0 decimal places.
    For example, 1234.56 meters will be formatted as "1,235 m".
    -->
    <string name="amu_in_meters" translatable="false">%1$,.0f m</string>

    <!--
    Distance in kilometers under 10 kilometers, formatted to 1 decimal place (at least 2
    significant digits for 1.0–9.9 km, keeping trailing .0).
    For example, 2.0 kilometers will be formatted as "2.0 km" and 1.94 kilometers as "1.9 km".
    -->
    <string name="amu_in_kilometers" translatable="false">%1$,.1f km</string>

    <!--
    Distance in kilometers for 10 kilometers or greater, formatted to 0 decimal places.
    For example, 12.4 kilometers will be formatted as "12 km".
    -->
    <string name="amu_in_kilometers_whole" translatable="false">%1$,.0f km</string>
</resources>
