<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zindex_demo_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zindex_demo_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/resetButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reset_zindex"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_restart_alt_24"
                    app:tint="?attr/colorControlNormal" />
            </LinearLayout>

            <!-- Row for Polygon 1 (Coral) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot_coral" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zindex_polygon_1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polygon1Minus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/decrement_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/polygon1ZIndexText"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_zindex_pill"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    tools:text="z: 1.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polygon1Plus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/increment_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Row for Polygon 2 (Teal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot_teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zindex_polygon_2"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polygon2Minus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/decrement_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/polygon2ZIndexText"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_zindex_pill"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    tools:text="z: 2.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polygon2Plus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/increment_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Row for Polyline 1 (Gold) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot_gold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zindex_polyline_1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polyline1Minus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/decrement_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/polyline1ZIndexText"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_zindex_pill"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    tools:text="z: 3.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polyline1Plus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/increment_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Row for Polyline 2 (Purple) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot_purple" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zindex_polyline_2"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polyline2Minus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/decrement_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/polyline2ZIndexText"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_zindex_pill"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    tools:text="z: 4.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/polyline2Plus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/increment_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Row for Point Marker (Green) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zindex_marker"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markerMinus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/decrement_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/markerZIndexText"
                    android:layout_width="60dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/bg_zindex_pill"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    tools:text="z: 5.0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markerPlus"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/increment_zindex"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="18dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
