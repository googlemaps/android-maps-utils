<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 0. Dataset Size Selection -->
        <TextView
            android:id="@+id/text_dataset_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clustering_settings_dataset_title"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clustering_settings_dataset_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <RadioGroup
            android:id="@+id/radio_group_dataset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_dataset_100k"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clustering_settings_dataset_100k"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_dataset_1m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clustering_settings_dataset_1m" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/listDivider" />

        <!-- 1. Cluster Radius (Density) -->
        <TextView
            android:id="@+id/text_radius_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clustering_settings_radius_format"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clustering_settings_radius_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:valueFrom="40.0"
            android:valueTo="200.0"
            android:stepSize="20.0"
            android:value="140.0" />

        <!-- 2. Min Cluster Size -->
        <TextView
            android:id="@+id/text_minsize_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clustering_settings_minsize_format"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clustering_settings_minsize_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_minsize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:valueFrom="2.0"
            android:valueTo="20.0"
            android:stepSize="1.0"
            android:value="2.0" />

        <!-- 3. Significant Non-Zero Digits -->
        <TextView
            android:id="@+id/text_digits_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clustering_settings_digits_format"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clustering_settings_digits_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_digits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:valueFrom="1.0"
            android:valueTo="3.0"
            android:stepSize="1.0"
            android:value="1.0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?android:attr/listDivider" />

        <!-- 4. Toggle: Show Exact Counts -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_exact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clustering_settings_exact_counts"
            android:textAppearance="?attr/textAppearanceBody1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:text="@string/clustering_settings_exact_counts_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 5. Toggle: Compact SI Notation -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_compact_notation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clustering_settings_compact_notation"
            android:textAppearance="?attr/textAppearanceBody1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:text="@string/clustering_settings_compact_notation_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 6. Toggle: Uppercase Units -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_uppercase_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clustering_settings_uppercase_units"
            android:textAppearance="?attr/textAppearanceBody1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/clustering_settings_uppercase_units_desc"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
