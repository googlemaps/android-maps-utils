      <name>Google Maps Platform Developer Relations</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:github.com/googlemaps/android-maps-robolectric.git</connection>
    <developerConnection>scm:git:ssh://github.com/googlemaps/android-maps-robolectric.git</developerConnection>
    <url>https://github.com/googlemaps/android-maps-robolectric/tree/main</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.google.android.gms</groupId>
      <artifactId>play-services-maps</artifactId>
      <version>20.0.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
