  <modelVersion>4.0.0</modelVersion>
  <groupId>com.google.android.maps.testing</groupId>
  <artifactId>visual</artifactId>
  <version>1.1.0-rc01</version>
  <packaging>aar</packaging>
  <name>Android Maps Visual Testing</name>
  <description>AI-powered visual verification and screenshot testing library for Google Maps SDK on Android.</description>
  <url>https://github.com/googlemaps/android-maps-robolectric</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
